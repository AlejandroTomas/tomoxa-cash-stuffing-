new file mode 100644
index 0000000000000000000000000000000000000000..ab90ffa2f2e1572b77ec5cc9be58ed69441b1913
--- /dev/null
+++ b/dist/notch.js
@@ -0,0 +1,20 @@
+'use strict';
+// Local Sileo notch geometry. Keep the command sequence identical for SVG morphing.
+function notchPath(left, width, height, roundness = 22) {
+    const right = left + width;
+    const shoulder = Math.min(14, height / 3);
+    const radius = Math.min(roundness, height - shoulder, width / 2);
+    const k = 0.5522847498;
+    return [
+        `M ${left - shoulder} 0`,
+        `H ${right + shoulder}`,
+        `C ${right + shoulder * (1 - k)} 0 ${right} ${shoulder * (1 - k)} ${right} ${shoulder}`,
+        `V ${height - radius}`,
+        `C ${right} ${height - radius * (1 - k)} ${right - radius * (1 - k)} ${height} ${right - radius} ${height}`,
+        `H ${left + radius}`,
+        `C ${left + radius * (1 - k)} ${height} ${left} ${height - radius * (1 - k)} ${left} ${height - radius}`,
+        `V ${shoulder}`,
+        `C ${left} ${shoulder * (1 - k)} ${left - shoulder * (1 - k)} 0 ${left - shoulder} 0 Z`
+    ].join(' ');
+}
+exports.notchPath = notchPath;
